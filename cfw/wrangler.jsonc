{
  // This file IS the instance config (specs/branch-model.md): one instance per
  // branch/fork. This branch (`oa`) is Open Athena's instance (gh.oa.dev),
  // forked from the `rw` branch's reference config. Deploys route through
  // scripts/oa-wrangler.sh (OA-account creds).
  "name": "watchy",
  "account_id": "74981a43be0de7712369306c7b19133d",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "triggers": {
    // */5 = collect + slack + enrich (tight enough that Slack post ts ≈ action ts);
    // Monday 14:00 UTC = weekly summary (WEEKLY_CRON in index.ts)
    "crons": ["*/5 * * * *", "0 14 * * 1"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchy",
      "database_id": "d2ddeb4b-d689-481a-8015-9ed9e38e79a6"
    }
  ],
  "dev": {
    // rw uses 4199/4200 (www/worker) — offset so both branches' dev servers coexist
    "port": 4202
  },
  "assets": {
    "directory": "../www/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/check", "/test-pushover", "/summary-preview"]
  },
  "vars": {
    "TARGETS": {
      "stars": ["Open-Athena", "marin-community"],
      "follows": ["Open-Athena", "marin-community"]
    },
    // UTC hour of the daily full sweep (bypasses the count-delta gate)
    "FULL_SWEEP_HOUR": "8"
  },
  "observability": {
    "enabled": true
  }
}
