{
  // This file IS the instance config (specs/branch-model.md): one instance per
  // branch/fork. This branch (`oa`) is Open Athena's instance (gh.oa.dev),
  // forked from the `rw` branch's reference config. Deploys route through
  // scripts/oa-wrangler.sh (OA-account creds).
  "name": "watchy",
  "account_id": "74981a43be0de7712369306c7b19133d",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "triggers": {
    // */5 = collect + slack + enrich (tight enough that Slack post ts ≈ action ts);
    // Monday 14:00 UTC = weekly summary (WEEKLY_CRON in index.ts)
    "crons": ["*/5 * * * *", "0 14 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchy",
      "database_id": "d2ddeb4b-d689-481a-8015-9ed9e38e79a6"
    }
  ],
  "dev": {
    // rw uses 4199/4200 (www/worker) — offset so both branches' dev servers coexist
    "port": 4202
  },
  "assets": {
    "directory": "../www/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/check", "/test-pushover", "/summary-preview", "/weekly-refresh"]
  },
  "vars": {
    "TARGETS": {
      "stars": ["Open-Athena", "marin-community"],
      "follows": ["Open-Athena", "marin-community"]
    },
    // UTC hour of the daily full sweep (bypasses the count-delta gate)
    "FULL_SWEEP_HOUR": "8",
    // Auth gate (secrets, via oa-wrangler.sh: SESSION_SECRET) + actor research
    // (secret: ANTHROPIC_API_KEY)
    "ADMIN_EMAILS": ["ryan.williams@openathena.ai"],
    // SSO identities from these domains get the `internal` scope; admins above
    // always get `*`, so a mistake here can't lock the operator out
    "AUTH_DOMAINS": ["openathena.ai"],
    "DASHBOARD_URL": "https://gh.oa.dev",
    "RESEARCH_MIN_FOLLOWERS": "100",
    // Slack posting (secret: SLACK_BOT_TOKEN)
    "SLACK_CHANNEL_ID": "C0BKZUV1SKH",
    "SLACK_WORKSPACE_URL": "https://openathena.slack.com",
    "SLACK_MATCHES": ["Open-Athena", "marin-community"],
    "SLACK_ORG_EMOJI": {
      "Open-Athena": "open-athena",
      "marin-community": "marin-community"
    },
    "SLACK_USER_MAP": {
      "alxmrs": "U08800J4DQR",
      "ClassicLarry": "U0A91M5PG6Q",
      "dlwh": "U09CB26C44Q",
      "eric-czech": "U086ET565LP",
      "forklady42": "U08SBKVRBS5",
      "gonzalobenegas": "U098XCDS6NQ",
      "hammer": "U07V3S3NQRH",
      "Helw150": "U09UPJBGFFW",
      "ihodes": "U09H5DG7490",
      "jder": "U086XUETAJ0",
      "mcwitt": "U0BH3S95CQ1",
      "michaelabbott": "U07V13REVL5",
      "muchanem": "U0BHEQBQBHD",
      "penfever": "U0B7LUWF1R6",
      "ravwojdyla": "U0A6E3V5NBW",
      "rjpower": "U09B54B93E3",
      "ryan-williams": "U0922LQRRM0",
      "sophiebushwick": "U0ABUGLRLQ6",
      "timodonnell": "U08GPNZAKHU",
      "yaelelmatad": "U09VDTYDQKW",
      "yonromai": "U0A66GZDNTF",
      "znichols": "U0BHU5D4N5U"
    }
  },
  "observability": {
    "enabled": true
  }
}
