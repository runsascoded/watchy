{
  "name": "watchy-cfw",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:oa": "wrangler deploy -e oa",
    "typecheck": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply watchy --remote",
    "migrate:oa": "wrangler d1 migrations apply watchy -e oa --remote",
    "migrate:local": "wrangler d1 migrations apply watchy --local",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
